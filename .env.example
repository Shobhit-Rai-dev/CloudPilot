# ==========================================
# CloudOps Control Plane Configuration
# ==========================================

# Database Connection
# Defaults to SQLite for zero-friction local execution without external containers.
# To connect to PostgreSQL, set: postgresql://username:password@localhost:5432/cloudops
DATABASE_URL=sqlite:///./cloudops.db

# JWT Secret Key
JWT_SECRET=cloudops-hackathon-secure-jwt-key-2026

# Cloud Provider Mode: "mock" (recommended for local demo) or "aws"
CLOUD_PROVIDER=mock

# AWS Configuration (Optional: only needed if CLOUD_PROVIDER=aws)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=